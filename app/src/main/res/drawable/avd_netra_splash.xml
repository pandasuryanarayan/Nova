    <target android:name="eye_upper_lid">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="470"
                android:interpolator="@android:interpolator/overshoot"
                android:propertyName="pathData"
                android:startOffset="110"
                android:valueFrom="M24,54 C33,57.5 43,59.5 54,59.5 C65,59.5 75,57.5 84,54"
                android:valueTo="M24,54 C33,41.5 43,33.5 54,33.5 C65,33.5 75,41.5 84,54"
